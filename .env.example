# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.

# Supabase — lecture des chapitres/compétences (clé anon, RLS appliqué)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ⚠️ Service role key : bypass le RLS. Utilisée par TaxonomyManager (écriture chapitres/compétences).
# Toute variable VITE_* est embarquée dans le bundle JS livré au navigateur :
# ne déployez JAMAIS cette application publiquement avec cette clé renseignée.
VITE_SUPABASE_SERVICE_KEY=eyJ...

# API Novlearn (lecture/écriture des exercices). Préférer https.
VITE_NOVLEARN_API_URL=https://novlearn.fr/api/exercises
# VITE_NOVLEARN_API_URL=http://localhost:3000/api/exercises

# Secret transmis dans l'en-tête x-admin-secret pour publier/supprimer (même remarque : embarqué dans le bundle)
VITE_ADMIN_SECRET=change_me
